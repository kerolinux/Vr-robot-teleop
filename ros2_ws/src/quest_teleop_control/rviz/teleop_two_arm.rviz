Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Target pose (right arm)
      Shape: Axes
      Axes Length: 0.12
      Axes Radius: 0.008
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /teleop/target_pose
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Target pose (left arm)
      Shape: Axes
      Axes Length: 0.12
      Axes Radius: 0.008
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /left/teleop/target_pose
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Right hand skeleton
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /teleop/right_hand/markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Left hand skeleton
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /teleop/left_hand/markers
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.6
      Focal Point:
        X: 0.3
        Y: 0.0
        Z: 0.4
      Pitch: 0.45
      Yaw: 0.9
Window Geometry:
  Height: 900
  Width: 1400
