  <!-- Mock ros2_control hardware (position command interfaces) for the hand joints. -->
  <xacro:macro name="shadow_hand_ros2_control" params="name prefix">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
      <joint name="${prefix}thumb_joint1">
        <command_interface name="position">
          <param name="min">-1.047198</param>
          <param name="max">1.047198</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}thumb_joint2">
        <command_interface name="position">
          <param name="min">0.000000</param>
