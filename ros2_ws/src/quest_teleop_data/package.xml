<?xml version="1.0"?>
<package format="3">
  <name>quest_teleop_data</name>
  <version>0.1.0</version>
  <description>Demonstration recording (HDF5 + optional rosbag), replay and inspection for imitation learning.</description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>quest_teleop_msgs</depend>
  <depend>quest_teleop_control</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-h5py</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
